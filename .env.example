# Copy to .env in the repo root (gitignored). Server-side only: never prefix any of these with NEXT_PUBLIC_.
PAYPAL_ENV=sandbox            # app refuses to boot otherwise
PAYPAL_CLIENT_ID=             # your own sandbox REST app (scopes: invoicing, reporting/search)
PAYPAL_CLIENT_SECRET=
NEBIUS_API_KEY=               # Nebius Token Factory key with a spend cap
# LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
# DEMO_BUYER_EMAIL=sb-xxxx@personal.example.com   # your sandbox personal (buyer) account
# RECIPIENT_DOMAIN=personal.example.com           # recipient allowlist
# PAYPAL_WEBHOOK_ID=          # set after registering https://<host>/api/webhooks/paypal in the developer dashboard
# DEMO_ALLOW_SIM=1            # local dev only: accept simulated webhooks marked x-duespilot-sim: 1
